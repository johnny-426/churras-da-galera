@page "{id:int}"
@model CdG.Pages.Eventos.EditarModel

@{
    ViewData["Title"] = "Editar evento";
}

<h1>Editar evento</h1>

<form method="post" asp-route-id="@Model.EventoId">
    <input type="hidden" asp-for="VersaoOriginal" />
    <p><a asp-page="Editar" asp-route-id="@Model.EventoId">Recarregar os dados atuais</a> (descarta alterações não salvas)</p>
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Entrada.Nome" class="form-label">
            Nome do evento
        </label>
        <input asp-for="Entrada.Nome" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Descricao" class="form-label">
            Descrição (opcional)
        </label>
        <textarea asp-for="Entrada.Descricao"
                  class="form-control" rows="3"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.Local" class="form-label">
            Local
        </label>
        <input asp-for="Entrada.Local" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Entrada.LimiteParticipantes" class="form-label">
            Limite de participantes (opcional)
        </label>
        <input asp-for="Entrada.LimiteParticipantes"
               type="number" min="1" class="form-control" />
        <div class="form-text">
            Deixe vazio para não definir um limite.
            O organizador conta como participante.
        </div>
    </div>

    <button type="submit" class="btn btn-primary">
        Salvar alterações
    </button>

    <a asp-page="/Eventos/Detalhes"
       asp-route-id="@Model.EventoId"
       class="btn btn-secondary">
        Voltar sem salvar
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
