@page "{id:int}"
@model CdG.Pages.Eventos.FinanceiroModel
@using CdG.Models
@{ ViewData["Title"] = "Financeiro — " + Model.Evento.Nome; }
<h1>Financeiro</h1>
<p class="lead">@Model.Evento.Nome</p>
<a asp-page="Detalhes" asp-route-id="@Model.Evento.Id">Voltar ao evento</a>
@if (Model.Mensagem != null) { <div class="alert alert-info mt-3" role="status">@Model.Mensagem</div> }
<div class="card my-4"><div class="card-body">
<h2 class="h4">Total de despesas: @FinanceiroModel.Dinheiro(Model.Despesas.Where(x => !x.Anulada).Sum(x => x.Centavos))</h2>
@if (Model.Evento.FinanceiroFechadoEm == null) {
<p>Rateio aberto. As despesas serão divididas igualmente entre os confirmados no fechamento, incluindo organizadores confirmados. Quem registrou uma despesa deve anulá-la antes de cancelar a própria presença ou sair.</p>
<form method="post" class="row g-3">
<input type="hidden" name="acao" value="despesa" />
<div class="col-md-7"><label for="descricao" class="form-label">O que você pagou?</label><input id="descricao" name="descricao" maxlength="200" required class="form-control" /></div>
<div class="col-md-3"><label for="valor" class="form-label">Valor (R$)</label><input id="valor" name="valor" inputmode="decimal" placeholder="Ex.: 35,90" required class="form-control" /></div>
<div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary">Registrar</button></div>
</form>
@if (Model.Organizador && (Model.Evento.Status == StatusEvento.Concluido || Model.Evento.Status == StatusEvento.Cancelado)) {
<form method="post" class="mt-3" onsubmit="return confirm('Fechar definitivamente o rateio? Confira despesas e confirmados. Depois não será possível alterar despesas ou cotas.');"><input type="hidden" name="acao" value="fechar" /><button class="btn btn-success">Fechar rateio</button></form>
}
<p class="text-muted mt-3">O fechamento fica disponível após concluir ou cancelar o evento. Em cancelamentos, registre apenas custos efetivos não reembolsados; anule gastos devolvidos antes de fechar.</p>
} else {
<p>Rateio fechado. Despesas e cotas estão preservadas; acertos continuam disponíveis.</p>
<strong>@(Model.Saldos.Values.All(x => x == 0) ? "Financeiro quitado" : "Há acertos pendentes")</strong>
}
</div></div>
<h2 class="h4">Despesas</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Descrição</th><th>Pago por</th><th>Valor</th><th>Situação</th></tr></thead><tbody>
@foreach (var d in Model.Despesas) {
<tr><td>@d.Descricao</td><td>@d.Pagador.Nome</td><td>@FinanceiroModel.Dinheiro(d.Centavos)</td><td>
@if (d.Anulada) { <span>Anulada</span> } else if (Model.Evento.FinanceiroFechadoEm == null && d.PagadorId == Model.UsuarioId) {
<form method="post" onsubmit="return confirm('Anular esta despesa?');"><input type="hidden" name="acao" value="anular" /><input type="hidden" name="registro" value="@d.Id" /><button class="btn btn-sm btn-outline-danger">Anular</button></form>
} else { <span>Registrada</span> }</td></tr>
}
</tbody></table></div>
@if (Model.Evento.FinanceiroFechadoEm != null) {
<h2 class="h4">Cotas e saldos</h2>
<p>Saldo positivo: a receber. Negativo: a pagar. Os centavos restantes são distribuídos em ordem fixa; a diferença entre cotas é de no máximo um centavo.</p>
<div class="table-responsive"><table class="table"><thead><tr><th>Pessoa</th><th>Cota</th><th>Saldo</th></tr></thead><tbody>
@foreach (var c in Model.Cotas) { <tr><td>@c.Usuario.Nome</td><td>@FinanceiroModel.Dinheiro(c.Centavos)</td><td>@FinanceiroModel.Dinheiro(Model.Saldos.GetValueOrDefault(c.UsuarioId))</td></tr> }
</tbody></table></div>
@if (Model.Saldos.GetValueOrDefault(Model.UsuarioId) < 0) {
<h2 class="h4">Informar pagamento feito fora do sistema</h2><p>Combine o pagamento com o credor. O saldo muda somente quando ele confirmar o recebimento.</p>
<form method="post" class="row g-3 mb-4"><input type="hidden" name="acao" value="pagar" />
<div class="col-md-5"><label for="destino">Quem recebeu?</label><select id="destino" name="destino" class="form-select" required>
@foreach (var c in Model.Cotas.Where(x => Model.Saldos.GetValueOrDefault(x.UsuarioId) > 0)) { <option value="@c.UsuarioId">@c.Usuario.Nome — @FinanceiroModel.Dinheiro(Model.Saldos[c.UsuarioId])</option> }
</select></div><div class="col-md-4"><label for="pagamento">Valor (R$)</label><input id="pagamento" name="valor" required inputmode="decimal" class="form-control" /></div><div class="col-md-3 d-flex align-items-end"><button class="btn btn-primary">Informar pagamento</button></div></form>
}
@if (Model.Saldos.GetValueOrDefault(Model.UsuarioId) > 0) {
<form method="post" class="mb-4" onsubmit="return confirm('Abrir mão de TODO seu saldo a receber? A ação é definitiva e reduz dívidas em ordem fixa de participantes.');"><input type="hidden" name="acao" value="renunciar" /><button class="btn btn-outline-secondary">Abrir mão do meu crédito restante</button></form>
}
<h2 class="h4">Histórico de acertos</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>De</th><th>Para</th><th>Valor</th><th>Situação</th><th>Ações</th></tr></thead><tbody>
@foreach (var a in Model.Acertos) {
<tr><td>@a.De.Nome</td><td>@a.Para.Nome</td><td>@FinanceiroModel.Dinheiro(a.Centavos)</td><td>@(a.Cancelado ? "Cancelado" : a.Renuncia ? "Renúncia do credor" : a.ConfirmadoEm != null ? "Recebimento confirmado" : "Aguardando recebimento")</td><td>
@if (!a.Cancelado && a.ConfirmadoEm == null) {
@if (a.ParaId == Model.UsuarioId) { <form method="post" onsubmit="return confirm('Você realmente recebeu esse valor?');"><input type="hidden" name="acao" value="confirmar" /><input type="hidden" name="registro" value="@a.Id" /><button class="btn btn-sm btn-success">Confirmar recebimento</button></form> }
@if (a.ParaId == Model.UsuarioId || a.DeId == Model.UsuarioId) { <form method="post"><input type="hidden" name="acao" value="cancelar" /><input type="hidden" name="registro" value="@a.Id" /><button class="btn btn-sm btn-outline-danger">Cancelar registro</button></form> }
}</td></tr>
}
</tbody></table></div>
}
